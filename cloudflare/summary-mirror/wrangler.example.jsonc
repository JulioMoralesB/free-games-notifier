// Copy to wrangler.jsonc (gitignored) and fill in the two REPLACE_ME values.
// Setup walkthrough: docs/summary-mirror.md. Secrets are NOT set here — use
// `wrangler secret put` (DASHBOARD_API_KEY, INGEST_TOKEN, DISCORD_WEBHOOK_URL).
{
  "name": "free-games-summary",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // Serve the mirror on the same hostname the notifier already uses: only
  // /api/summary and /api/summary/snapshot go to this Worker; every other path
  // keeps reaching your server through its tunnel / reverse proxy. The hostname
  // must be proxied by Cloudflare (orange cloud). No zone of your own? Remove
  // "routes" and set "workers_dev": true to use the *.workers.dev URL instead.
  "workers_dev": false,
  "routes": [
    { "pattern": "REPLACE_ME_HOSTNAME/api/summary*", "zone_name": "REPLACE_ME_ZONE" }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "free-games-summary",
      "database_id": "REPLACE_ME_DATABASE_ID", // printed by `wrangler d1 create free-games-summary`
      "migrations_dir": "migrations"
    }
  ],

  // Freshness alert: one Cron Trigger (counts 1 against the account's 5 on the
  // Free plan), firing hourly. It alerts at most once per stale episode.
  "triggers": { "crons": ["0 * * * *"] },

  "vars": {
    "STALE_AFTER_HOURS": "26"
  },

  "observability": { "enabled": true }
}
